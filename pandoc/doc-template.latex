\documentclass[11pt,a4paper]{article}

% Margins
\usepackage[top=2cm, bottom=2cm, left=2.2cm, right=2.2cm]{geometry}

% Fonts
\usepackage{fontspec}
\setmainfont{Open Sans}
\setsansfont{Open Sans}

% Maths symbols (pandoc uses these; \square comes from amssymb)
\usepackage{amsmath}
\usepackage{amssymb}

% Open Sans has no arrow glyph — map it to the maths one
\catcode`→=\active
\def→{\ensuremath{\rightarrow}}

% Tables, in case
\usepackage{longtable,booktabs,array}

% Colours
\usepackage{xcolor}
\definecolor{heading}{HTML}{1a3a5c}
\definecolor{accent}{HTML}{2c5f8a}
\definecolor{bodytext}{HTML}{2d2d2d}
\definecolor{lightgray}{HTML}{cccccc}

\color{bodytext}

% Links
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=accent,
  urlcolor=accent,
  pdfborder={0 0 0},
$if(title)$
  pdftitle={$title$},
$endif$
}

% Headings — unnumbered, in the body and in the ToC
\setcounter{secnumdepth}{-1}
\usepackage{titlesec}

\titleformat{\section}
  {\Large\bfseries\color{heading}}
  {}{0em}{}[\textcolor{lightgray}{\rule{\textwidth}{0.4pt}}]
\titlespacing{\section}{0pt}{16pt}{6pt}

\titleformat{\subsection}
  {\large\bfseries\color{heading}}
  {}{0em}{}
\titlespacing{\subsection}{0pt}{12pt}{3pt}

\titleformat{\subsubsection}
  {\normalsize\bfseries\color{accent}}
  {}{0em}{}
\titlespacing{\subsubsection}{0pt}{8pt}{2pt}

\titleformat{\paragraph}[runin]
  {\normalsize\bfseries\color{accent}}
  {}{0em}{}
\titlespacing{\paragraph}{0pt}{6pt}{0.6em}

% Lists
\usepackage{enumitem}
\setlist[itemize]{topsep=2pt, itemsep=2pt, parsep=0pt, leftmargin=1.4em}
\setlist[enumerate]{topsep=2pt, itemsep=2pt, parsep=0pt, leftmargin=1.6em}

% Spacing
\usepackage{parskip}
\setlength{\parskip}{5pt}
\setlength{\parindent}{0pt}
\usepackage{setspace}
\setstretch{1.06}

% Page numbers, centred footer
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small\textcolor{lightgray!80!black}{\thepage}}

% Block quotes — indented, italic, in the heading colour
\renewenvironment{quote}
  {\list{}{\leftmargin=1.4em\rightmargin=1.4em\topsep=6pt}%
   \item\relax\color{heading}\itshape}
  {\endlist}

% Pandoc compatibility
\providecommand{\tightlist}{%
  \setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

\begin{document}

$if(title)$
\begin{center}
  {\huge\bfseries\color{heading} $title$}\\[6pt]
$if(subtitle)$
  {\large\color{accent} $subtitle$}\\[4pt]
$endif$
$if(date)$
  {\small\color{bodytext} $date$}
$endif$
\end{center}
\vspace{10pt}
$endif$

$if(toc)$
{\hypersetup{linkcolor=bodytext}
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
\vspace{12pt}
$endif$

$body$

\end{document}
