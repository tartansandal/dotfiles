# Homebrew completions (only if brew is installed). ~/.zprofile already exported
# HOMEBREW_PREFIX via `brew shellenv`, so prefer that over shelling out to
# `brew --prefix` (~20ms). Fall back for non-login shells that skipped zprofile.
if [[ -z ${HOMEBREW_PREFIX:-} ]] && type brew &>/dev/null; then
  HOMEBREW_PREFIX="$(brew --prefix)"
fi
[[ -n ${HOMEBREW_PREFIX:-} ]] &&
  FPATH="$HOMEBREW_PREFIX/share/zsh/site-functions:${FPATH}"

# User-local completions generated by local-bin-install (Linux servers); inert
# if the dirs don't exist. Where XDG_DATA_HOME points at host-local storage (the
# dev servers move it off the NFS home), those completions win, with the $HOME
# copy kept as a fallback. Assembled before compinit so it only has to run once.
typeset -U fpath
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
[[ -n ${XDG_DATA_HOME:-} && -d $XDG_DATA_HOME/zsh/site-functions ]] &&
  fpath=("$XDG_DATA_HOME/zsh/site-functions" $fpath)

# Run the full compinit (security audit + dump rebuild) at most once a day;
# otherwise load the cached dump with -C, which skips both.
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Bash-like completion behavior: complete stem, list on ambiguity
setopt no_auto_menu
setopt bash_auto_list
setopt list_ambiguous
setopt no_menu_complete
setopt list_types
unsetopt rec_exact

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:default' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' list-separator '--'

source ~/dotfiles/shell/aliases

# fzf keybindings and completion (env vars set in shell/aliases)
if command -v fzf >/dev/null && fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# direnv (if installed)
if type direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# Prompt: starship if installed, otherwise a simple fallback
if type starship &>/dev/null; then
  eval "$(starship init zsh)"
else
  PROMPT='%F{blue}%~%f %# '
fi

# Machine-specific overrides (not tracked)
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
